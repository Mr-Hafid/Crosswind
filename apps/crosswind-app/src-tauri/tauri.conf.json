{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crosswind",
  "version": "0.1.0",
  "identifier": "io.github.mrhafid.crosswind",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Crosswind",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
